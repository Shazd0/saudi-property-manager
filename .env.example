# Copy to .env.local and fill in the token.
VITE_DATA_BACKEND=mac
VITE_MAC_API_URL=/
# Required on Netlify so voice-call WebSocket goes direct to Mac API (Netlify cannot proxy WS).
VITE_MAC_PROXY_TARGET=https://api.amlak-app.com
VITE_MAC_API_TOKEN=your-api-token-here

# Same token must match Mac Mini AMLAK_API_TOKEN
# On Netlify set these 3 vars, then Redeploy.

# Local Ollama via Vite same-origin proxy /ollama → 127.0.0.1:11434 (avoids CORS)
# VITE_LOCAL_AI_URL=/ollama
# VITE_LOCAL_AI_PROXY_TARGET=http://127.0.0.1:11434
# VITE_LOCAL_AI_MODEL=stable-qwen:latest
# Optional cloud fallback if Ollama is offline
# VITE_GROQ_API_KEY=gsk_...
