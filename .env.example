# Firebase-only mode (post Mac Mini migration).
# Copy to .env.local for local development.

# Optional: owner automation proxy (Netlify sets VITE_OWNER_AUTOMATION_URL=/owner-api)
# VITE_OWNER_AUTOMATION_URL=/owner-api

# Local Ollama via Vite same-origin proxy /ollama → 127.0.0.1:11434
# VITE_LOCAL_AI_URL=/ollama
# VITE_LOCAL_AI_PROXY_TARGET=http://127.0.0.1:11434
# VITE_LOCAL_AI_MODEL=stable-qwen:latest
