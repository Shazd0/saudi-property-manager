# Copy to .env in this folder (Firebase Functions) or set in Cloud Console / Secret Manager.
# Must match VITE_SALES_CONSOLE_PASSWORD in production builds (Sales Console UI lock).

SALES_CONSOLE_PASSWORD=change-me-use-a-long-random-secret

# Optional — defaults to SALES_CONSOLE_PASSWORD if unset
# GIFT_REVEAL_SECRET=

# Optional — ZATCA onboarding function only
# ZATCA_CSR_PEM=
