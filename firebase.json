{
  "auth": {
    "authorizedDomains": [
      "localhost",
      "amlak-app.com",
      "www.amlak-app.com",
      "saudi-property-manager.firebaseapp.com",
      "saudi-property-manager.web.app"
    ],
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Amlak",
        "supportEmail": "amlakrealestateofficial@gmail.com"
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/owner.html",
        "destination": "/owner.html"
      },
      {
        "source": "/tenant.html",
        "destination": "/tenant.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
