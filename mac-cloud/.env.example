# Copy to project root as .env (Docker Compose reads it automatically):
#   cp mac-cloud/.env.example .env && chmod 600 .env
# Every secret below is intentionally invalid. Generate independent values:
#   openssl rand -base64 48
# Generate database passwords without URL punctuation, or URL-encode them:
#   openssl rand -hex 32
# Never commit .env or put server credentials in a browser/client bundle.

POSTGRES_DB=amlak
POSTGRES_USER=amlak
POSTGRES_PASSWORD=INVALID_GENERATE_POSTGRES_ADMIN_PASSWORD
POSTGRES_PORT=5432

AMLAK_API_PORT=8787
AMLAK_API_TOKEN=INVALID_GENERATE_API_TOKEN
CORS_ORIGIN=https://buyer-app.invalid

# Push server for incoming calls when app is closed.
FCM_PUSH_URL=http://fcm-push:3200
FCM_PUSH_PORT=3200

# Owner MCP authentication and network policy.
# Inside Compose, the mcp service overrides MCP_HOST to 0.0.0.0; keep host
# publish on 127.0.0.1 only (see docker-compose.mac-mini.yml).
MCP_HOST=127.0.0.1
MCP_PORT=8791
MCP_OWNER_TOKEN=INVALID_GENERATE_48_BYTE_OWNER_TOKEN
MCP_OWNER_ID=INVALID_SET_STABLE_OWNER_ID
# Include the public hostname Cloudflare Tunnel presents to /mcp and /owner.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,mcp.private.invalid,owner.private.invalid
ASSISTANT_CORS_ORIGINS=https://buyer-app.invalid

# ---------------------------------------------------------------------------
# Cloudflare Access (required for owner browser /owner API)
# ---------------------------------------------------------------------------
# Browser owner API uses Cloudflare Access JWTs only.
# Never put MCP_OWNER_TOKEN in a browser, Vite env, or client bundle.
#
# Team domain / issuer (must match exactly; issuer is team domain + trailing /):
#   MCP_OWNER_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
#   MCP_OWNER_ACCESS_ISSUER=https://<team>.cloudflareaccess.com/
#
# Create separate Zero Trust Access applications when practical:
#   1) Owner web app — protects the owner UI origin and /owner API path.
#      Copy that application's AUD into MCP_OWNER_ACCESS_AUD (required by the
#      MCP server JWT verifier for Cf-Access-Jwt-Assertion).
#   2) MCP app — protects the /mcp Streamable HTTP hostname/path at the edge.
#      Record that application's AUD in comments/ops notes only. The MCP server
#      authenticates clients with MCP_OWNER_TOKEN and does not consume a second
#      AUD env var today.
#
# Allowlisted owner emails (comma-separated, lowercased at runtime):
#   MCP_OWNER_ACCESS_EMAILS=owner@example.invalid,ops@example.invalid
#
# Exact HTTPS origins allowed to call /owner (no wildcards):
#   MCP_OWNER_WEB_CORS_ORIGINS=https://owner-app.invalid
# Production example:
#   MCP_OWNER_WEB_CORS_ORIGINS=https://amlakrrgroup.netlify.app,https://amlak-app.com,https://mcp.amlak-app.com
#
# Frontend build-time guidance (owner web app, NOT this Compose file):
#   VITE_OWNER_AUTOMATION_URL=https://owner-app.invalid/owner
# Must be the Access-protected public origin + /owner path used by
# services/ownerAutomationService.ts. Relative "/owner" only works when the
# owner UI is same-origin with the MCP tunnel.
# ---------------------------------------------------------------------------
MCP_OWNER_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
MCP_OWNER_ACCESS_ISSUER=https://example.cloudflareaccess.com/
MCP_OWNER_ACCESS_AUD=INVALID_SET_OWNER_WEB_ACCESS_APPLICATION_AUD
# MCP_ACCESS_AUD=INVALID_SET_MCP_ACCESS_APPLICATION_AUD_CONSOLE_ONLY
MCP_OWNER_ACCESS_EMAILS=owner@example.invalid
MCP_OWNER_WEB_CORS_ORIGINS=https://owner-app.invalid
# VITE_OWNER_AUTOMATION_URL=https://owner-app.invalid/owner

# Create separate least-privilege roles by following mac-cloud/MCP.md.
# These URLs must use different roles and passwords.
MCP_DATABASE_URL=postgres://amlak_mcp:INVALID_READ_ROLE_PASSWORD@postgres:5432/amlak
MCP_COMMAND_DATABASE_URL=postgres://amlak_mcp_command:INVALID_COMMAND_ROLE_PASSWORD@postgres:5432/amlak
# The worker may use the command role because it updates durable automation rows.
AUTOMATION_DATABASE_URL=postgres://amlak_mcp_command:INVALID_COMMAND_ROLE_PASSWORD@postgres:5432/amlak

# Stable Mac tenant and fresh proof secret. Never expose the critical secret to
# Cursor, Gemini, a buyer app, browser code, logs, or dispatcher endpoints.
MCP_MAC_TENANT_ID=INVALID_SET_STABLE_MAC_TENANT_ID
MCP_CRITICAL_ACTION_SECRET=INVALID_GENERATE_SEPARATE_48_BYTE_CRITICAL_SECRET
MCP_CONFIRMATION_TTL_MS=120000
MCP_CRITICAL_REAUTH_MAX_AGE_MS=300000
MCP_QUERY_TIMEOUT_MS=5000
MCP_RATE_LIMIT=60

# Firebase project map is server-only. Omitted capabilities means [] (deny all).
# Capabilities gate owner-managed buyer-target commands (MCP prepare/confirm),
# not buyer browser writes. Buyer browsers remain request-only for reversals.
# Grant exact IDs or narrow prefixes only; avoid "*" outside a controlled rollout.
# See mac-cloud/MCP.md "Buyer capability grants".
# Private keys use literal \n escapes because this value is one JSON line.
# Start with enabled:false and capabilities:[]; enable after identity checks.
BUYER_FIREBASE_PROJECTS_JSON={"buyer-project-invalid":{"buyerId":"INVALID_BUYER_ID","tenantId":"INVALID_STABLE_TENANT_ID","bookId":"INVALID_BOOK_ID","schemaVersion":1,"enabled":false,"buildingIds":[],"capabilities":[],"serviceAccount":{"project_id":"buyer-project-invalid","client_email":"invalid@buyer-project-invalid.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\nINVALID_NOT_A_REAL_KEY\\n-----END PRIVATE KEY-----\\n"}}}

# Durable worker and authenticated loopback-only event ingestion.
AUTOMATION_EVENT_TOKEN=INVALID_GENERATE_SEPARATE_48_BYTE_EVENT_TOKEN
AUTOMATION_EVENT_PORT=8792
AUTOMATION_CONTAINER_MODE=true
AUTOMATION_POLL_MS=5000
AUTOMATION_REQUEST_TIMEOUT_MS=10000

# Server-controlled dispatcher allowlists. Keys are exact action/job IDs.
# Each endpoint's auth value selects a token from AUTOMATION_SERVICE_TOKENS_JSON.
# Keep empty until real dispatcher credentials exist (fail closed / dead-letter).
AUTOMATION_OUTBOX_ENDPOINTS_JSON={}
AUTOMATION_JOB_ENDPOINTS_JSON={}
AUTOMATION_SERVICE_TOKENS_JSON={}
# Configured example shapes (still intentionally invalid — do not enable in prod
# until real HTTPS dispatchers and independent tokens are provisioned):
# AUTOMATION_OUTBOX_ENDPOINTS_JSON={"notification.send.v1":{"url":"https://dispatcher.invalid/notification","auth":"notifications","timeoutMs":10000}}
# AUTOMATION_JOB_ENDPOINTS_JSON={"backup.create.v1":{"url":"https://jobs.invalid/backup","auth":"backup-worker","timeoutMs":30000}}
# AUTOMATION_SERVICE_TOKENS_JSON={"notifications":"INVALID_GENERATE_SERVICE_TOKEN","backup-worker":"INVALID_GENERATE_DIFFERENT_SERVICE_TOKEN"}

# Optional OpenAI-compatible model endpoint. Leave all unset for deterministic
# summaries. AI_API_KEY is server-only when used.
# AI_BASE_URL=http://ai:11434/v1
# AI_API_KEY=INVALID_OPTIONAL_AI_KEY
# AI_MODEL=qwen3:8b
